<div class="d-flex flex-wrap justify-content-center align-items-center gap-3">
    <MudPagination Count="TotalPages" 
                   Selected="CurrentPage" 
                   SelectedChanged="OnSelectedPageChanged" 
                   ShowFirstButton="true" 
                   ShowLastButton="true" />

    <MudSelect T="int" Value="currentRecordsNumber" ValueChanged="OnRecordsNumberChanged" 
               Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 150px; background-color: white;">
        @foreach (var option in options)
        {
            <MudSelectItem Value="@option.Value">@option.Name</MudSelectItem>
        }
    </MudSelect>
</div>