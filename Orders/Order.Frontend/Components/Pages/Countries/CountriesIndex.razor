@page "/countries"

<h3>Paises</h3>

@if(Countries == null)
{
    <Loading Label="Cargando paises, por favor espera ..."/>
}
else
{
    <table border="1">
        <tr>
            <td>Pais</td>
        </tr>

        @foreach (var country in Countries)
        {
            <tr>
                <td>@country.Name</td>
            </tr>
        }
    </table>
}